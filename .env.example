# ===========================================
# 八字算命 API 服务 - 环境变量配置示例
# ===========================================
# 复制此文件为 .env 并填入实际值

# ----- 数据库配置 -----
# Railway 会自动注入此变量（添加 PostgreSQL 后）
DATABASE_URL="postgresql://user:password@localhost:5432/bazi"

# ----- JWT 配置 -----
# 用于签名和验证 JWT token，请使用强密码
# 可用命令生成: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-key-change-this-in-production"

# ----- AI 服务配置 -----
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"

# ----- 短信服务配置 -----
# mock: 模拟发送（开发用），aliyun: 阿里云短信
SMS_PROVIDER="mock"
ALIYUN_SMS_ACCESS_KEY_ID=""
ALIYUN_SMS_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""

# ----- 服务配置 -----
PORT=3000
NODE_ENV="development"

# ----- CORS 配置 -----
# 允许的前端域名，多个用逗号分隔
# 生产环境请设置为具体的前端域名
CORS_ORIGIN="*"

# ----- 业务配置 -----
# 新用户注册赠送的积分数量
INITIAL_GIFT_POINTS=100
