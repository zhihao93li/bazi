# ===========================================
# 八字算命 API 服务 - 环境变量配置
# ===========================================
# 复制此文件为 .env 并填入实际值

# ----- 数据库配置 -----
# Railway 会自动注入此变量（添加 PostgreSQL 后）
DATABASE_URL="postgresql://user:password@localhost:5432/bazi"

# ----- JWT 配置 -----
# 用于签名和验证 JWT token
# 生产环境建议配置，可用命令生成: openssl rand -base64 32
# 如不配置，代码会使用默认值（不安全）
JWT_SECRET=""

# ----- AI 服务配置（aihubmix）-----
# aihubmix API Key（在 https://aihubmix.com 获取）
AIHUBMIX_API_KEY="sk-your-api-key"
# aihubmix API 基础 URL（可选，有默认值）
AIHUBMIX_BASE_URL="https://aihubmix.com/v1"

# ----- 数据加密配置 -----
# 敏感数据加密密钥（生产环境必须配置）
# 可用命令生成: openssl rand -base64 32
ENCRYPTION_KEY=""

# ----- 短信服务配置 -----
# mock: 模拟发送（开发用），aliyun: 阿里云短信
SMS_PROVIDER="mock"

# 阿里云短信配置（仅 SMS_PROVIDER=aliyun 时需要）
ALIYUN_ACCESS_KEY_ID=""
ALIYUN_ACCESS_KEY_SECRET=""
ALIYUN_SMS_SIGN_NAME=""
ALIYUN_SMS_TEMPLATE_CODE=""

# ----- 服务配置 -----
PORT=3000
NODE_ENV="development"

# ----- CORS 配置 -----
# 允许的前端域名，多个用逗号分隔
# 生产环境请设置为具体的前端域名
CORS_ORIGIN="*"

# ----- 业务配置 -----
# 新用户注册赠送的积分数量
INITIAL_GIFT_POINTS=100
# 命理分析消耗积分数
FORTUNE_ANALYSIS_COST=50

# ----- Stripe 支付配置 -----
# Stripe 密钥（测试环境使用 sk_test_，生产环境使用 sk_live_）
STRIPE_SECRET_KEY="sk_test_xxx"
# Stripe Webhook 签名密钥（在 Stripe Dashboard -> Webhooks 获取）
STRIPE_WEBHOOK_SECRET="whsec_xxx"
# 前端地址（用于 Stripe 支付回调）
FRONTEND_URL="http://localhost:5173"

# ----- 码支付（Mazfu）配置 -----
# 商户ID（在码支付后台获取）
MAZFU_PID=""
# 商户密钥（在码支付后台获取，用于签名验证）
MAZFU_KEY=""
# 异步通知URL（支付成功后码支付服务器回调地址）
# 格式: https://your-domain.com/api/payment/mazfu-notify
MAZFU_NOTIFY_URL=""
# 同步跳转URL（支付完成后用户跳转地址）
# 格式: https://your-domain.com/api/payment/mazfu-return
MAZFU_RETURN_URL=""
