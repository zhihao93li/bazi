// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  username     String?  @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pointsAccount     PointsAccount?
  transactions      PointsTransaction[]
  orders            PaymentOrder[]
  subjects          Subject[]
  reports           FortuneReport[]
  verificationCodes VerificationCode[]
  themeAnalyses     ThemeAnalysis[]
}

// 测算对象（用户可以为自己或他人创建）
model Subject {
  id           String   @id @default(cuid())
  userId       String   // 创建者
  name         String   // 姓名/昵称
  gender       String   // male/female
  calendarType String   // solar/lunar
  birthYear    Int
  birthMonth   Int
  birthDay     Int
  birthHour    Int
  birthMinute  Int
  isLeapMonth  Boolean  @default(false)
  location     String   // 出生地点（省/市/区 三级格式，如 "北京市/北京市/朝阳区"）
  baziData     Json?    // 存储完整八字计算结果（前端计算后传入）
  relationship String?  // 与用户关系：self/family/friend/other
  note         String?  // 备注
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // AI 解读相关字段
  initialAnalysis   Json?     // 初步解读结果（后台参考资料，不展示给用户）
  initialAnalyzedAt DateTime? // 初步解读时间

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports        FortuneReport[]
  themeAnalyses  ThemeAnalysis[]

  @@index([userId, createdAt])
}

model VerificationCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, createdAt])
}

model PointsAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model PointsTransaction {
  id          String   @id @default(cuid())
  userId      String
  type        String   // recharge, consume, gift
  amount      Int
  balance     Int      // 变动后余额
  description String
  orderId     String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PaymentOrder {
  id              String    @id @default(cuid())
  userId          String
  orderNo         String    @unique
  amount          Int       // 金额（分）
  points          Int       // 对应积分
  paymentMethod   String    // stripe, alipay_qrcode, alipay_h5
  status          String    @default("pending") // pending, paid, failed, refunded
  transactionId   String?   // Stripe Payment Intent ID 或其他支付渠道交易号
  stripeSessionId String?   // Stripe Checkout Session ID
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderNo])
  @@index([stripeSessionId])
}

model PointsPackage {
  id        String  @id @default(cuid())
  name      String
  points    Int
  price     Int     // 金额（分）
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model FortuneReport {
  id         String    @id @default(cuid())
  userId     String    // 付费用户
  subjectId  String?   // 测算对象（可选，兼容旧数据）
  birthInfo  Json      // 出生信息
  baziChart  Json      // 八字排盘结果
  analysis   Json      // AI 分析结果
  pointsCost Int       // 消耗积分
  createdAt  DateTime  @default(now())
  deletedAt  DateTime? // 软删除

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([subjectId, createdAt])
}

// 主题解读记录（按主题付费解锁）
model ThemeAnalysis {
  id         String   @id @default(cuid())
  userId     String   // 付费用户
  subjectId  String   // 测算对象
  theme      String   // 主题标识：life_color, relationship, career_wealth, health, life_lesson, yearly_fortune
  content    Json     // 解读内容
  pointsCost Int      // 消耗积分
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, theme]) // 一个对象一个主题只有一条记录（永久解锁）
  @@index([userId, subjectId])
}

// 主题价格配置
model ThemePricing {
  id            String  @id @default(cuid())
  theme         String  @unique // 主题标识
  name          String          // 显示名称
  description   String?         // 主题描述
  price         Int             // 积分价格（当前价格/折扣价）
  originalPrice Int?            // 原价（用于显示划线价格，如200打折到150）
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
}

// 异步任务（持久化存储）
model Task {
  id          String    @id @default(cuid())
  type        String    // 任务类型：theme_unlock
  status      String    @default("pending") // pending, processing, completed, failed
  payload     Json      // 任务参数
  result      String?   // 任务结果（成功时）
  error       String?   // 错误信息（失败时）
  userId      String    // 任务所属用户
  createdAt   DateTime  @default(now())
  startedAt   DateTime? // 开始处理时间
  completedAt DateTime? // 完成时间

  @@index([userId, createdAt])
  @@index([status])
  @@index([type, status])
}
