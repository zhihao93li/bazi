{
  "$schema": "https://json-schema.zeabur.app/zeabur.json",
  "build": {
    "type": "dockerfile",
    "dockerfile": "Dockerfile"
  },
  "start": {
    "command": "node dist/index.js"
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000"
  },
  "healthCheck": {
    "path": "/health",
    "port": 3000
  }
}
