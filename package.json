{
  "name": "bazi-fortune-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "dev:prod": "NODE_ENV=production tsx watch src/index.ts",
    "build": "prisma generate && tsc && cp -r prisma dist/prisma && cp -r config dist/config",
    "start": "NODE_ENV=production prisma db push --schema=dist/prisma/schema.prisma --accept-data-loss && node dist/index.js",
    "lint": "eslint",
    "test": "NODE_ENV=test vitest --run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest --run --coverage",
    "db:push": "prisma db push",
    "db:push:dev": "NODE_ENV=development prisma db push",
    "db:studio": "prisma studio",
    "db:studio:dev": "NODE_ENV=development prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "china-location": "^2.1.0",
    "dotenv": "^17.2.3",
    "dotenv-flow": "^4.1.0",
    "hono": "^4.7.5",
    "jose": "^6.0.11",
    "lunar-typescript": "^1.8.6",
    "openai": "^6.15.0",
    "pg": "^8.16.3",
    "prisma": "^7.2.0",
    "stripe": "^20.1.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9",
    "fast-check": "^4.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
